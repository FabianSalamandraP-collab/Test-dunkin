# ====================================================
# ARCHIVO DE EJEMPLO - NO SUBIR CREDENCIALES REALES
# Copia este archivo como .env.local y llena las variables
# ====================================================

# ====================================================
# CONFIGURACIÓN DE SUPABASE (BASE DE DATOS)
# ====================================================
# Obtén estas credenciales en tu dashboard de Supabase.
# Son opcionales si quieres desplegar solo la experiencia base sin persistencia.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ====================================================
# CONFIGURACIÓN DEL SITIO WEB
# ====================================================
# URL principal del sitio (para SEO y enlaces)
NEXT_PUBLIC_SITE_URL=https://tu-dominio-final.com

# Código opcional de verificación de Google Search Console
GOOGLE_SITE_VERIFICATION=

# ====================================================
# BENEFICIOS DINAMICOS DESDE DUNKIN PEDIR
# ====================================================
# Clave privada solo para sincronizar promociones al backend.
# Solo se necesita si vas a activar la capa de sincronizacion con Supabase.
BENEFITS_SYNC_SECRET=

# Clave privada de Supabase para sincronizaciones servidor a servidor.
# Solo se necesita si vas a activar la sync de beneficios.
# Tambien se utiliza para la nueva capa de tracking del quiz desde endpoints
# backend. Esta variable la debe configurar exclusivamente el equipo de
# despliegue en el entorno remoto o en su .env.local privado.
SUPABASE_SERVICE_ROLE_KEY=

# ====================================================
# NOTAS IMPORTANTES
# ====================================================
# - NUNCA subas el archivo .env.local al repositorio
# - .env.example es seguro porque no contiene credenciales reales
# - Las variables que empiezan con NEXT_PUBLIC_ son accesibles en el cliente
# - Las variables sin NEXT_PUBLIC_ solo son accesibles en el servidor
# - BENEFITS_SYNC_SECRET y SUPABASE_SERVICE_ROLE_KEY nunca deben exponerse
# - Sin variables de Supabase la app despliega igual, pero usa fallback y no guarda registros
